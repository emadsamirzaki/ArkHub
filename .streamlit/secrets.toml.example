# Copy this file to .streamlit/secrets.toml and fill in your Neon connection string.
# secrets.toml is git-ignored — never commit it.
#
# Get your DATABASE_URL from:
#   console.neon.tech → your project → Connection Details → Connection string
#
# For Streamlit Community Cloud:
#   Settings → Secrets → paste the key/value below

DATABASE_URL = "postgresql://user:password@ep-xxx-yyy.us-east-2.aws.neon.tech/neondb?sslmode=require"
